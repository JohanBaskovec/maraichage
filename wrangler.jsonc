{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "maraichage",
	"compatibility_date": "2026-11-08",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	// Aucune tâche planifiée sur le site (elles sont dans workers/taches). Liste vide
	// explicite : efface un déclencheur qui aurait été posé par erreur.
	"triggers": { "crons": [] },
	"preview_urls": true,
	// Cloudflare Access (back-office) : nom d'équipe Zero Trust et « AUD tag » de l'application.
	// Valeurs publiques, pas des secrets. Si elles sont vides, /admin est fermé en production.
	"vars": {
		"ACCESS_EQUIPE": "gentle-firefly-1b6f",
		"ACCESS_AUD": "bf61cefa894ad35999a366cbe47f3dc2adad231ca02141b64eb6a3063ba92127",
		// Clé publique du widget Turnstile (la clé secrète est le secret TURNSTILE_SECRET).
		// Sans le secret, la vérification anti-robot est désactivée.
		"TURNSTILE_CLE_SITE": "0x4AAAAAAF6Pu5DF3iNhD03X"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maraichage",
			"database_id": "95d2921a-6bfe-442f-a5da-d987240e12ef",
			"migrations_dir": "drizzle"
		}
	]
}
